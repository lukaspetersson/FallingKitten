<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/third_party_notices_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/third_party_notices_title"
        android:textColor="#212121"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/third_party_notices_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/third_party_notices_content_description"
            android:lineSpacingExtra="3dp"
            android:textColor="#212121"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/third_party_notices_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/third_party_notices_back_content_description"
        android:minHeight="48dp"
        android:onClick="closeNotices"
        android:text="@string/third_party_notices_back" />

</LinearLayout>
